<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Producto | ELLI</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f4f9f5;
            color: #222;
            line-height: 1.6;
        }

        header {
            background-color: #123524;
            color: white;
            padding: 20px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            font-size: 30px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
            font-weight: bold;
        }

        nav a:hover {
            color: #f4b400;
        }

        .hero {
            background: linear-gradient(135deg, #123524, #286b45);
            color: white;
            text-align: center;
            padding: 80px 20px;
        }

        .hero h2 {
            font-size: 50px;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 20px;
            max-width: 800px;
            margin: auto;
        }

        section {
            padding: 60px 8%;
            text-align: center;
        }

        section h2 {
            color: #123524;
            font-size: 35px;
            margin-bottom: 25px;
        }

        .producto {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 50px;
            max-width: 1100px;
            margin: auto;
            flex-wrap: wrap;
        }

        .producto img {
            width: 400px;
            max-width: 100%;
            border-radius: 20px;
        }

        .descripcion {
            max-width: 500px;
            text-align: left;
            font-size: 18px;
        }

        .descripcion h3 {
            color: #123524;
            font-size: 30px;
            margin-bottom: 15px;
        }

        .caracteristicas {
            background-color: #e5f3e9;
        }

        .tarjetas {
            display: flex;
            justify-content: center;
            gap: 25px;
            flex-wrap: wrap;
            margin-top: 35px;
        }

        .tarjeta {
            background-color: white;
            width: 280px;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .tarjeta .icono {
            font-size: 45px;
            margin-bottom: 15px;
        }

        .tarjeta h3 {
            color: #123524;
            margin-bottom: 12px;
        }

        .tarjeta p {
            font-size: 16px;
        }

        .lista {
            max-width: 700px;
            margin: 30px auto;
            text-align: left;
        }

        .lista li {
            margin: 15px 0;
            font-size: 18px;
            list-style: none;
        }

        .boton {
            display: inline-block;
            margin-top: 25px;
            padding: 15px 30px;
            background-color: #f4b400;
            color: #111;
            text-decoration: none;
            border-radius: 30px;
            font-weight: bold;
        }

        .boton:hover {
            background-color: #d99d00;
        }

        footer {
            background-color: #123524;
            color: white;
            text-align: center;
            padding: 30px;
        }

        @media (max-width: 700px) {

            header {
                flex-direction: column;
                gap: 15px;
            }

            nav a {
                margin: 5px;
            }

            .hero h2 {
                font-size: 38px;
            }

            .descripcion {
                text-align: center;
            }

        }

    </style>

</head>


<body>


    <!-- ENCABEZADO -->

    <header>

        <h1>ELLI </h1>

        <nav>

            <a href="../index.html">Inicio</a>

            <a href="../empresa/index.html">
                La Empresa
            </a>

            <a href="index.html">
                Producto
            </a>

            <a href="../tecnologia/index.html">
                Tecnología
            </a>

            <a href="../contacto/index.html">
                Contacto
            </a>

        </nav>

    </header>


    <!-- PRESENTACIÓN -->

    <div class="hero">

        <h2> Mochila ELLI</h2>

        <p>
            Una mochila tecnológica diseñada para combinar
            comodidad, innovación y energía solar.
        </p>

    </div>


    <!-- INFORMACIÓN DEL PRODUCTO -->

    <section>

        <div class="producto">

            <div>

                <!-- Puedes cambiar esta imagen por la de tu mochila -->

                <img
                    src="https://images.unsplash.com/photo-1553062407-98eeb64c6a62"
                    alt="Mochila tecnológica ELLI">

            </div>


            <div class="descripcion">

                <h3>Conoce ELLI</h3>

                <p>
                    ELLI es una mochila tecnológica que incorpora
                    un sistema de captación de energía solar para
                    ofrecer una solución práctica a las personas
                    durante sus actividades diarias.
                </p>

                <br>

                <p>
                    Su diseño busca integrar tecnología y
                    sostenibilidad en un producto cómodo,
                    funcional y fácil de transportar.
                </p>

                <a href="../contacto/index.html" class="boton">
                    Más información
                </a>

            </div>

        </div>

    </section>


    <!-- CARACTERÍSTICAS -->

    <section class="caracteristicas">

        <h2> Características del producto</h2>

        <div class="tarjetas">


            <div class="tarjeta">

                <div class="icono"></div>

                <h3>Panel Solar</h3>

                <p>
                    Panel integrado que aprovecha la energía
                    del sol para generar electricidad.
                </p>

            </div>


            <div class="tarjeta">

                <div class="icono"></div>

                <h3>Sistema de Energía</h3>

                <p>
                    Sistema pensado para almacenar y disponer
                    de energía para dispositivos compatibles.
                </p>

            </div>


            <div class="tarjeta">

                <div class="icono"></div>

                <h3>Diseño Funcional</h3>

                <p>
                    Una mochila diseñada para transportar objetos
                    y tecnología de manera práctica.
                </p>

            </div>


            <div class="tarjeta">

                <div class="icono">🌱</div>

                <h3>Sostenible</h3>

                <p>
                    Utiliza una fuente de energía renovable
                    como parte de su propuesta tecnológica.
                </p>

            </div>


            <div class="tarjeta">

                <div class="icono">💡</div>

                <h3>Innovadora</h3>

                <p>
                    Combina una mochila tradicional con
                    soluciones tecnológicas.
                </p>

            </div>


            <div class="tarjeta">

                <div class="icono">📱</div>

                <h3>Conectividad</h3>

                <p>
                    Pensada para ayudar al usuario a mantener
                    sus dispositivos disponibles cuando lo necesite.
                </p>

            </div>

        </div>

    </section>


    <!-- ¿QUÉ INCLUYE? -->

    <section>

        <h2> ¿Qué incluye ELLI?</h2>

        <ul class="lista">

            <li> Sistema de panel solar</li>

            <li> Sistema de almacenamiento de energía</li>

            <li> Conexiones para dispositivos compatibles</li>

            <li> Compartimentos para objetos personales</li>

            <li> Sistema tecnológico integrado</li>

            <li> Propuesta basada en energía renovable</li>

        </ul>

    </section>


    <!-- BENEFICIOS -->

    <section class="caracteristicas">

        <h2> Beneficios de ELLI</h2>

        <div class="tarjetas">

            <div class="tarjeta">

                <div class="icono"></div><div></div>

                <h3>Energía portátil</h3>

                <p>
                    Lleva una solución energética contigo
                    durante tus actividades.
                </p>

            </div>


            <div class="tarjeta">

                <div class="icono"></div>

                <h3>Energía renovable</h3>

                <p>
                    Aprovecha la energía solar como parte
                    del funcionamiento del producto.
                </p>

            </div>


            <div class="tarjeta">

                <div class="icono">🚀</div>

                <h3>Innovación</h3>

                <p>
                    Una propuesta que combina moda,
                    tecnología y sostenibilidad.
                </p>

            </div>

        </div>

    </section>


    <!-- PIE DE PÁGINA -->

    <footer>

        <p>
            © 2026 ELLI | Innovación que te acompaña 
        </p>

    </footer>


</body>

</html>
